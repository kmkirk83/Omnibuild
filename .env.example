# Copy this file to .env for local development. Never commit your real .env file.
#
# Stripe local development:
# stripe listen --forward-to http://localhost:3000/webhooks/stripe
# Copy the whsec_... value printed by the CLI into STRIPE_WEBHOOK_SECRET.
STRIPE_WEBHOOK_SECRET=

# Shopify HTTPS webhooks:
# Set this to the app client secret that signs X-Shopify-Hmac-SHA256.
SHOPIFY_API_SECRET=

# The remaining application variables are supplied by the deployment platform.
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
