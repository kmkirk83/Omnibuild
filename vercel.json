{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/webhooks/shopify",
      "destination": "/api/webhooks/shopify"
    },
    {
      "source": "/webhooks/stripe",
      "destination": "/api/webhooks/stripe"
    }
  ],
  "functions": {
    "api/webhooks/[provider].ts": {
      "maxDuration": 15
    }
  }
}
